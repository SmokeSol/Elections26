# The B2 raw acquisition vault is an immutable byte-for-byte archive. Its
# recorded SHA-256 digests are computed over the retrieved bytes, so any
# line-ending translation on checkout would corrupt the evidence and invalidate
# every hash. Treat the whole vault as binary.
morocco26/data/goal100/b2_raw_acquisition/** -text -diff

# Ingested raw source files are archived evidence for the same reason.
morocco26/data/goal100/historical/raw/** -text -diff
morocco26/data/goal100/older_history_probe/raw/** -text -diff

# E_collect raw evidence is append-only and hash-addressed.
morocco26/data/goal100/e_collect/runs/**/raw/** -text -diff

# Le front v2 est extrait d'une archive dont chaque fichier est hache dans
# MANIFEST_source_v2.sha256. Toute traduction de fin de ligne, a la lecture comme a
# l'ecriture, invaliderait le manifeste : l'arbre entier est traite comme binaire.
morocco26/frontends/agent_society_opus/source_v2/** -text
morocco26/frontends/agent_society_opus/source_v2/web/data/contrib/** -text -diff

# The canonical current-vintage named 2026 input is hash-addressed: its sha256
# is recorded in the R0 data-layer certificate, in the ballot-cell census and in
# the population lineage. Any line-ending translation on checkout would change
# those digests, so the file is treated as bytes.
morocco26/data/goal100/agent_society_v2/named_input_current_vintage_*.json -text -diff
